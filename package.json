{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:runtime": "node scripts/runtime-audit.mjs",
    "audit:electron": "node scripts/electron-audit.mjs",
    "audit:production": "node scripts/production-regression.mjs",
    "audit:strictmode": "node scripts/strictmode-regression.mjs",
    "icon": "node scripts/make-ico.mjs",
    "desktop:build": "esbuild desktop/src/main.ts --bundle --platform=node --format=esm --external:electron --outfile=desktop/dist/main.js && esbuild desktop/src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop/dist/preload.cjs",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json",
    "desktop:start": "npm run build && npm run desktop:build && electron .",
    "desktop:dist": "npm run build && npm run desktop:build && electron-builder --win nsis --publish never --config.directories.output=/tmp/trafaret-windows-dist",
    "preview": "vite preview",
    "android:sync": "npm run build && PATH=/tmp/node22/bin:$PATH npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.562.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "1.62.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "ru.trafaret.studio",
    "productName": "Трафарет",
    "directories": {
      "output": "/mnt/agents/output/installers",
      "buildResources": "build"
    },
    "files": [
      "desktop/dist/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Trafaret-Setup-${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Трафарет",
      "installerIcon": "build/icon.ico",
      "script": "installer.nsi"
    }
  }
}
